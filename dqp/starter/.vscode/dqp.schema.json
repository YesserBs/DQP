{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DQP source 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dqp_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "start": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "enum": [
            "immediate",
            "end"
          ],
          "default": "end"
        }
      },
      "required": []
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "dqp_version",
    "id",
    "title",
    "description",
    "start",
    "questions"
  ],
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "compare"
            },
            "metric": {
              "enum": [
                "last_answer.correct"
              ]
            },
            "operator": {
              "enum": [
                "eq",
                "ne"
              ]
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "metric",
            "operator",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "compare"
            },
            "metric": {
              "enum": [
                "last_answer.choice"
              ]
            },
            "operator": {
              "enum": [
                "eq",
                "ne"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "required": [
            "kind",
            "metric",
            "operator",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "compare"
            },
            "metric": {
              "enum": [
                "answered_count",
                "correct_count",
                "consecutive_errors"
              ]
            },
            "operator": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "metric",
            "operator",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "conditions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "any"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "conditions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "kind",
            "condition"
          ]
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "choice": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "choice",
        "explanation"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "goto": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        }
      },
      "required": [
        "id",
        "when",
        "goto"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "not": {
            "const": "end"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          },
          "minItems": 2,
          "maxItems": 26
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "next": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        }
      },
      "required": [
        "id",
        "prompt",
        "choices",
        "answer",
        "next"
      ]
    }
  }
}
